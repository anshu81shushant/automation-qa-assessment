      "id": "bb37f042-c225-4739-99bf-05c6abebce4c",
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "// daily numbers, then reset\nconst stats = $getWorkflowStaticData('global');\nconst day = stats.day || { checks: {} };\nconst rows = Object.entries(day.checks).map(([name, s]) => {\n  const up = s.total ? (((s.total - s.failed) / s.total) * 100).toFixed(2) : 'n/a';\n  const avg = s.total ? Math.round(s.sumMs / s.total) : 0;\n  return `• **${name}** - uptime ${up}% (${s.total} checks, ${s.failed} failed) · avg ${avg} ms · max ${s.maxMs} ms · ${s.slow} slow (>3 s)`;\n});\nconst content = rows.length\n  ? [`📊 **Daily uptime summary** (since ${String(day.since).slice(0, 16).replace('T', ' ')} UTC)`, ...rows].join('\\n')\n  : '📊 **Daily uptime summary:** no checks recorded yet (static data only persists for active/production executions).';\nstats.day = { since: new Date().toISOString(), checks: {} };\nreturn [{ json: { content } }];"
      },
      "id": "9eb65026-dc53-469b-99af-81abbf9ef606",
      "name": "Build Daily Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
