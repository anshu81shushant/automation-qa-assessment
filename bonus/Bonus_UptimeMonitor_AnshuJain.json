      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "dcCred0000000001",
          "name": "Discord Webhook account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
